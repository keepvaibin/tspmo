# Maintainer: tspmo contributors
#
# Versioned release package: builds the tagged source (v$pkgver).
#   cp PKGBUILD.release PKGBUILD && makepkg -si      (downloads the GitHub tag)
# CI builds the checked-out tree instead:  TSPMO_SRC=/path/to/tree makepkg -f
#
# pkgver is replaced from the tag by CI (sed on the next line).
pkgbase=tspmo
pkgname=('tspmo' 'tspmo-hid-asus-dkms')
pkgver=0.9.0
pkgrel=1
pkgdesc="Thermal & System Power Management Optimizer for ASUS and Lenovo laptops"
arch=('x86_64')
url="https://github.com/keepvaibin/tspmo"
license=('GPL-3.0-or-later')
makedepends=('cargo' 'fontconfig' 'libxkbcommon' 'wayland' 'pkgconf')
options=('!lto' '!debug')
if [ -z "${TSPMO_SRC:-}" ]; then
  source=("tspmo-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
  sha256sums=('SKIP')
fi

_root() { if [ -n "${TSPMO_SRC:-}" ]; then realpath "$TSPMO_SRC"; else echo "$srcdir/tspmo-$pkgver"; fi; }

# No build directory in the binaries (makepkg warns about $srcdir references).
_flags() { export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build --remap-path-prefix=$(_root)=/src"; }

build() {
  cd "$(_root)"
  export CARGO_TARGET_DIR="$srcdir/target"
  _flags
  cargo build --release --locked
}

check() {
  cd "$(_root)"
  export CARGO_TARGET_DIR="$srcdir/target"
  _flags
  cargo test --release --locked --workspace
}

package_tspmo() {
  pkgdesc="Thermal & System Power Management Optimizer for ASUS and Lenovo laptops (power profiles, GPU modes, fans, lighting)"
  depends=('dbus' 'polkit' 'upower' 'kmod' 'systemd' 'fontconfig' 'libxkbcommon' 'wayland')
  install=tspmo.install
  optdepends=('nvidia-utils: NVIDIA GPU mode switching'
              'plasma-workspace: Plasma power-mode widget and ROG-key shortcut'
              'libkscreen: refresh rate, flicker-free dimming and colour modes (kscreen-doctor)'
              'kconfig: eye care (kreadconfig6, kwriteconfig6)'
              'tspmo-hid-asus-dkms: lets ASUS keyboard/lighting chips sleep (~0.6 W)')
  # tspmod implements the power-profiles D-Bus API itself.
  provides=('power-profiles-daemon')
  conflicts=('tspmo-git' 'power-profiles-daemon' 'tuned-ppd')
  local r; r="$(_root)"
  BIN_SRC="$srcdir/target/release" LICENSE_NAME="$pkgname" \
    sh "$r/packaging/install-files.sh" core "$r" "$pkgdir" /usr >/dev/null
}

package_tspmo-hid-asus-dkms() {
  pkgdesc="hid-asus that wakes the ASUS keyboard before backlight commands, so it can autosuspend (rebuilt for every kernel)"
  arch=('any')
  license=('GPL-2.0-only')
  depends=('dkms' 'curl' 'patch')
  local r; r="$(_root)"
  sh "$r/packaging/install-files.sh" dkms "$r" "$pkgdir" /usr >/dev/null
}
