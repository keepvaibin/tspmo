[Desktop Entry]
Type=Application
Name=tspmo
GenericName=Power and hardware control
Comment=Modes, GPU, screen, battery, fans, lighting
Exec=tspmo-gui
Icon=preferences-system-power-management
Terminal=false
Categories=System;Settings;HardwareSettings;
StartupWMClass=org.tspmo.gui
# The window is a layer-shell flyout: it never maps a toplevel, so a launch-feedback entry (the
# bouncing cursor, a task manager placeholder) would never be matched and would linger.
StartupNotify=false
X-KDE-StartupNotify=false
