<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>tspmo</vendor>

  <!-- The standard power-profiles actions (same ids as power-profiles-daemon). -->
  <action id="org.freedesktop.UPower.PowerProfiles.switch-profile">
    <description>Switch power profile</description>
    <message>Authentication is required to switch the power profile</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
  <action id="org.freedesktop.UPower.PowerProfiles.hold-profile">
    <description>Hold power profile</description>
    <message>Authentication is required to hold the power profile</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-gpu">
    <description>Change the GPU mode</description>
    <message>Authentication is required to change the GPU mode</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-fans">
    <description>Change fan curves</description>
    <message>Authentication is required to change fan curves</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-power">
    <description>Change power limits</description>
    <message>Authentication is required to change power limits</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-battery">
    <description>Change battery charging</description>
    <message>Authentication is required to change battery charging</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-hardware">
    <description>Change firmware settings</description>
    <message>Authentication is required to change firmware settings</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-lighting">
    <description>Change keyboard lighting</description>
    <message>Authentication is required to change keyboard lighting</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>

  <action id="org.tspmo.set-lid">
    <description>Change lid display</description>
    <message>Authentication is required to change lid display</message>
    <defaults><allow_any>auth_admin_keep</allow_any><allow_inactive>auth_admin_keep</allow_inactive><allow_active>yes</allow_active></defaults>
  </action>
</policyconfig>
