[Unit]
Description=tspmo daemon (power profiles, GPU modes, hardware control)
Documentation=https://github.com/tspmo/tspmo
# tspmod provides the power-profiles API itself.
Conflicts=power-profiles-daemon.service tuned-ppd.service
# Before the login screen, so the GPU mode and compositor settings are in place before any
# compositor opens a GPU.
Before=display-manager.service
After=upower.service
Wants=upower.service

[Service]
Type=dbus
BusName=org.freedesktop.UPower.PowerProfiles
ExecStart=/usr/bin/tspmod
# Eco+ caps the CPU's power limits: put them back whenever the daemon stops.
ExecStopPost=/usr/bin/tspmod --restore-limits
StateDirectory=tspmo
RuntimeDirectory=tspmo
RuntimeDirectoryPreserve=yes
Restart=on-failure
RestartSec=1

# Hardening. tspmod must write /sys and /proc/sys, load/unload the NVIDIA modules for GPU
# switching and talk to systemd; everything else is locked down.
ProtectSystem=strict
# read-only, not hidden: the daemon runs short commands as the desktop user (display, OSD),
# which need the user's runtime directory (Wayland and D-Bus sockets).
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
