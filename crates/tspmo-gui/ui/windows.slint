import { Th, Nav } from "theme.slint";
import { Bk, Item } from "bk.slint";
import { Btn, IconBtn, Combo, Seg, Check, Slide, SlideRow, Stepper, Row, Head, Cap, Mono, Rule } from "controls.slint";
import { CurveEditor } from "curve.slint";

// One firmware item: a checkbox, a stepper for choices and numbers, or plain text.
component HwRow inherits Rectangle {
    in property <Item> item;
    height: root.item.kind == "toggle" || root.item.kind == "text" || !root.item.writable ? 20 * Th.dp : Th.control;
    if root.item.kind == "toggle": Check {
        label: root.item.label;
        on: root.item.on;
        enabled: root.item.writable;
        toggled => { Bk.act("hw-toggle", root.item.name); }
    }
    if root.item.kind != "toggle": Row {
        h: root.height;
        label: root.item.label;
        if root.item.kind != "text" && root.item.writable: Stepper {
            width: 130 * Th.dp;
            text: root.item.text;
            prev => { Bk.acti("hw-step:" + root.item.name, -1); }
            next => { Bk.acti("hw-step:" + root.item.name, 1); }
        }
        if root.item.kind == "text" || !root.item.writable: Mono { text: root.item.text; }
    }
}

// A row of colour choices. Arrows move, Enter or Space applies, like the tile rows.
component Swatches inherits Rectangle {
    in property <[color]> colors;
    in property <int> index;
    in property <bool> enabled: true;
    callback picked(int);
    property <int> cur: index;
    height: 20 * Th.dp;
    opacity: enabled ? 1 : 0.4;
    fs := FocusScope {
        enabled: root.enabled;
        changed has-focus => {
            if (self.has-focus && Nav.keys) {
                root.cur = max(root.index, 0);
            }
        }
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.LeftArrow) {
                root.cur = max(root.cur - 1, 0);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.cur = min(root.cur + 1, root.colors.length - 1);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                root.picked(root.cur);
                return accept;
            }
            return reject;
        }
        for c[i] in root.colors: Rectangle {
            x: i * (self.width + 6 * Th.dp);
            width: (root.width - 6 * Th.dp * (root.colors.length - 1)) / max(root.colors.length, 1);
            height: root.height;
            border-radius: 2px;
            background: c;
            border-width: root.index == i ? 3px : 1px;
            border-color: root.index == i ? Th.focus : Th.line;
            Rectangle {
                border-radius: 2px;
                border-width: fs.has-focus && Nav.keys && i == root.cur ? 2px : 0;
                border-color: Th.bg;
            }
            TouchArea {
                clicked => {
                    fs.focus();
                    Nav.keys = false;
                    root.cur = i;
                    root.picked(i);
                }
            }
        }
    }
}

// A titled group inside a window.
component Group inherits VerticalLayout {
    in property <string> title;
    in property <string> value;
    spacing: 6 * Th.dp;
    Head { title: root.title; info: root.value; }
    @children
}

component WinFrame inherits Window {
    background: Th.bg;
    default-font-size: Th.font-size;
    default-font-family: Th.font-family;
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Escape) {
                Bk.close();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 16 * Th.dp;
            spacing: 10 * Th.dp;
            @children
            if Bk.error != "": Text {
                text: Bk.error;
                color: Th.danger;
                font-size: Th.t-small;
                wrap: word-wrap;
                max-width: 520 * Th.dp;
            }
        }
    }
}

// -------------------------------------------------------------------------------------------------
// Fans & Power

export component FansWin inherits WinFrame {
    title: "Fans & Power";
    HorizontalLayout {
        spacing: 16 * Th.dp;
        if Bk.has-fans: VerticalLayout {
            spacing: 6 * Th.dp;
            min-width: 300 * Th.dp;
            Seg {
                opts: [
                    { id: "silent", label: "Silent", tint: Th.mode-color("silent"), keyed: true },
                    { id: "balanced", label: "Balanced", tint: Th.mode-color("balanced"), keyed: true },
                    { id: "performance", label: "Turbo", tint: Th.mode-color("performance"), keyed: true },
                ];
                index: Bk.fan-mode;
                tint: Th.mode-color(["silent", "balanced", "performance"][clamp(Bk.fan-mode, 0, 2)]);
                picked(i) => { Bk.acti("fan-mode", i); }
            }
            Rectangle { height: 6 * Th.dp; }
            Head { title: "Fan"; info: Bk.fan-kind; }
            Seg {
                opts: Bk.fan-opts;
                index: Bk.fan-sel;
                picked(i) => { Bk.acti("fan-sel", i); }
            }
            CurveEditor {
                height: 190 * Th.dp;
                editable: Bk.fan-kind != "full";
            }
            HorizontalLayout {
                spacing: 6 * Th.dp;
                Btn { horizontal-stretch: 1; preferred-width: 0px; text: "Auto"; active: Bk.fan-kind == "auto"; clicked => { Bk.act("fan-auto", ""); } }
                Btn { horizontal-stretch: 1; preferred-width: 0px; text: "Full"; active: Bk.fan-kind == "full"; clicked => { Bk.act("fan-full", ""); } }
                Btn { horizontal-stretch: 1; preferred-width: 0px; text: "Factory"; clicked => { Bk.act("fan-reset", ""); } }
            }
        }
        if Bk.has-power: VerticalLayout {
            spacing: 6 * Th.dp;
            min-width: 300 * Th.dp;
            Seg {
                opts: [{ id: "ac", label: "AC", tint: Th.accent }, { id: "battery", label: "Battery", tint: Th.accent }];
                index: Bk.pw-source;
                picked(i) => { Bk.acti("pw-source", i); }
            }
            Rectangle { height: 6 * Th.dp; }
            Head { title: "Power limits"; }
            for l in Bk.limits: HorizontalLayout {
                spacing: 6 * Th.dp;
                SlideRow {
                    horizontal-stretch: 1;
                    label: l.label;
                    label-width: 130 * Th.dp;
                    value-width: 62 * Th.dp;
                    min: l.min;
                    max: l.max;
                    value-int: l.cur;
                    value: l.cur + " " + l.unit;
                    custom: l.custom;
                    enabled: l.max > l.min;
                    released(v) => { Bk.acti("limit:" + l.name, v); }
                }
                IconBtn {
                    icon: "reset";
                    side: 26 * Th.dp;
                    enabled: l.custom;
                    opacity: l.custom ? 1 : 0;
                    clicked => { Bk.act("limit-default", l.name); }
                }
            }
            Btn { text: "Firmware defaults"; clicked => { Bk.act("limit-reset", ""); } }
        }
    }
}

// -------------------------------------------------------------------------------------------------
// Screen

export component ScreenWin inherits WinFrame {
    title: "Screen";
    VerticalLayout {
        spacing: 14 * Th.dp;
        min-width: 320 * Th.dp;
        if Bk.has-refresh: Group {
            title: "Refresh rate";
            value: Bk.refresh-now;
            Seg {
                wheel: true;
                opts: [{ id: "auto", label: "Auto", tint: Th.accent }, { id: "60", label: "60 Hz", tint: Th.accent }, { id: "max", label: "Max", tint: Th.accent }];
                index: Bk.refresh-policy == "auto" ? 0 : Bk.refresh-policy == "60" ? 1 : Bk.refresh-policy == "max" ? 2 : -1;
                picked(i) => { Bk.act("refresh", ["auto", "60", "max"][i]); }
            }
        }
        if Bk.brightness >= 0 || Bk.has-flicker: Group {
            title: "Brightness";
            value: Bk.brightness >= 0 ? Bk.brightness + "%" : "";
            if Bk.brightness >= 0: Slide {
                min: 1;
                max: 100;
                value: Bk.brightness;
                released(v) => { Bk.acti("brightness", v); }
            }
            if Bk.has-flicker: Check {
                label: "Flicker-free dimming";
                on: Bk.flicker;
                toggled(v) => { Bk.act("flicker", v ? "on" : "off"); }
            }
        }
        if Bk.color-modes.length > 0: Group {
            title: "Color";
            Seg {
                opts: Bk.color-modes;
                index: Bk.color-idx;
                picked(i) => { Bk.act("color", Bk.color-modes[i].id); }
            }
        }
        if Bk.has-eye: Group {
            title: "Eye care";
            value: Bk.eye-kelvin > 0 ? Bk.eye-kelvin + " K" : "off";
            Check {
                label: "Warm white";
                on: Bk.eye-kelvin > 0;
                toggled(v) => { Bk.acti("eye", v ? 4500 : 0); }
            }
            if Bk.eye-kelvin > 0: Slide {
                min: 1000;
                max: 6500;
                step: 100;
                value: Bk.eye-kelvin;
                released(v) => { Bk.acti("eye", v); }
            }
        }
        if Bk.screen-items.length > 0: Group {
            title: "Panel";
            for it in Bk.screen-items: HwRow { item: it; }
        }
    }
}

// -------------------------------------------------------------------------------------------------
// Keyboard & Lid

export component KeysWin inherits WinFrame {
    title: "Keyboard & Lid";
    HorizontalLayout {
        spacing: 18 * Th.dp;
        if Bk.has-light: VerticalLayout {
            spacing: 14 * Th.dp;
            min-width: 300 * Th.dp;
            alignment: start;
            Group {
                title: "Keyboard";
                value: Bk.kb-level + " / " + Bk.kb-max;
                Slide {
                    min: 0;
                    max: max(Bk.kb-max, 1);
                    value: Bk.kb-level;
                    released(v) => { Bk.acti("kb-level", v); }
                }
            }
            if Bk.kb-effects.length > 0: Group {
                title: "Effect";
                Stepper {
                    text: Bk.kb-effect-idx < 0 ? "Choose effect" : Bk.kb-effect;
                    prev => { Bk.acti("kb-effect-step", -1); }
                    next => { Bk.acti("kb-effect-step", 1); }
                }
                if Bk.kb-uses-color: Swatches {
                    enabled: Bk.kb-effect-idx >= 0;
                    colors: [#ffffff, #ff3b30, #ff9500, #ffd60a, #34c759, #0a84ff, #bf5af2, #ff2d92];
                    index: Bk.kb-color-idx;
                    picked(i) => { Bk.acti("kb-color", i); }
                }
                if Bk.kb-uses-speed: Seg {
                    opts: [{ id: "low", label: "Slow", tint: Th.accent }, { id: "med", label: "Normal", tint: Th.accent }, { id: "high", label: "Fast", tint: Th.accent }];
                    index: Bk.kb-speed;
                    enabled: Bk.kb-effect-idx >= 0;
                    picked(i) => { Bk.acti("kb-speed", i); }
                }
            }
            Group {
                title: "Backlight on";
                GridLayout {
                    spacing: 3 * Th.dp;
                    for s[i] in ["Boot", "Awake", "Sleep", "Shutdown"]: Check {
                        row: floor(i / 2);
                        col: mod(i, 2);
                        label: s;
                        on: Bk.kb-states.length > i && Bk.kb-states[i];
                        toggled(v) => { Bk.acti("kb-state:" + i, v ? 1 : 0); }
                    }
                }
            }
            Group {
                title: "Off after idle";
                Stepper {
                    text: Bk.kb-idle;
                    prev => { Bk.acti("kb-idle-step", -1); }
                    next => { Bk.acti("kb-idle-step", 1); }
                }
            }
        }
        if Bk.has-slash || Bk.has-anime: VerticalLayout {
            spacing: 14 * Th.dp;
            min-width: 300 * Th.dp;
            alignment: start;
            if Bk.has-slash: Group {
                title: "Slash";
                value: Bk.slash-on ? round(Bk.slash-level / 2.55) + "%" : "off";
                Check { label: "Enabled"; on: Bk.slash-on; toggled(v) => { Bk.act("slash-on", v ? "on" : "off"); } }
                Slide {
                    min: 0;
                    max: 255;
                    step: 5;
                    value: Bk.slash-level;
                    enabled: Bk.slash-on;
                    released(v) => { Bk.acti("slash-level", v); }
                }
                if Bk.slash-modes.length > 0: Combo {
                    items: Bk.slash-modes;
                    index: Bk.slash-mode-idx;
                    picked(i) => { Bk.acti("slash-mode-set", i); }
                }
                HorizontalLayout {
                    spacing: 6 * Th.dp;
                    Combo {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        items: ["Off", "Low", "Medium", "High"];
                        index: Bk.slash-bright-idx;
                        picked(i) => { Bk.acti("slash-bright", i); }
                    }
                    Combo {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        right: true;
                        items: ["Interval Off", "Interval 1", "Interval 2", "Interval 3", "Interval 4", "Interval 5"];
                        index: Bk.slash-interval;
                        text: Bk.slash-interval > 5 ? "Interval " + Bk.slash-interval : "";
                        picked(i) => { Bk.acti("slash-interval", i); }
                    }
                }
            }
            if Bk.has-slash && Bk.slash-show.length > 0: Group {
                title: "Slash shows on";
                GridLayout {
                    spacing: 3 * Th.dp;
                    for it[i] in Bk.slash-show: Check {
                        row: floor(i / 2);
                        col: mod(i, 2);
                        label: it.label;
                        on: it.on;
                        toggled => { Bk.act("hw-toggle", it.name); }
                    }
                }
            }
            if Bk.has-anime: Group {
                title: "AniMe Matrix";
                value: Bk.anime-on ? Bk.anime-level + " / 3" : "off";
                Check { label: "Enabled"; on: Bk.anime-on; toggled(v) => { Bk.act("anime-on", v ? "on" : "off"); } }
                Slide { min: 0; max: 3; value: Bk.anime-level; enabled: Bk.anime-on; released(v) => { Bk.acti("anime-level", v); } }
            }
        }
    }
}

// -------------------------------------------------------------------------------------------------
// System

export component SystemWin inherits WinFrame {
    title: "System";
    HorizontalLayout {
        spacing: 18 * Th.dp;
        if Bk.has-battery: VerticalLayout {
            spacing: 14 * Th.dp;
            min-width: 300 * Th.dp;
            alignment: start;
            Group {
                title: "Charge limit";
                value: Bk.bat-limit > 0 ? Bk.bat-limit + "%" : "none";
                if Bk.bat-opts.length > 0: Seg {
                    opts: Bk.bat-opts;
                    index: Bk.bat-idx;
                    picked(i) => { Bk.acti("bat-limit", Bk.bat-values[i]); }
                }
                Check { label: "Charge to 100% once"; on: Bk.charge-once; toggled(v) => { Bk.act("charge-once", v ? "on" : "off"); } }
            }
            Group {
                title: "Battery";
                value: Bk.bat-line;
                for r in [["Health", Bk.bat-health], ["Cycles", Bk.bat-cycles], ["Power", Bk.bat-power], ["Time left", Bk.bat-left]]: HorizontalLayout {
                    height: 20 * Th.dp;
                    Cap { text: r[0]; horizontal-stretch: 1; }
                    Mono { text: r[1] == "" ? "-" : r[1]; }
                }
            }
        }
        VerticalLayout {
            spacing: 14 * Th.dp;
            min-width: 300 * Th.dp;
            alignment: start;
            if Bk.has-fnlock || Bk.system-items.length > 0: Group {
                title: "Hardware";
                if Bk.has-fnlock: Check { label: "Fn lock"; on: Bk.fnlock; toggled(v) => { Bk.act("fnlock", v ? "on" : "off"); } }
                for it in Bk.system-items: HwRow { item: it; }
            }
            if Bk.reboot-pending: Group {
                title: "Reboot to apply";
                Btn { text: "Reboot"; danger: true; clicked => { Bk.act("reboot", ""); } }
            }
            if Bk.has-gpu: Group {
                title: "GPU";
                value: Bk.gpu-state;
                if Bk.gpu-users.length == 0: Cap { text: "No apps"; }
                for u in Bk.gpu-users: HorizontalLayout {
                    height: 20 * Th.dp;
                    Text { text: u.name; color: Th.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    Mono { text: u.pid; }
                }
                if Bk.gpu-message != "": Cap { text: Bk.gpu-message; }
            }
        }
    }
}
