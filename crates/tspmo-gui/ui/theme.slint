// Design tokens. Sizes are in `dp`: 1dp is 1 logical px at the default 10 pt (13.33 px) system
// font and grows with the font, so layouts keep their proportions at any text size.
// `rem` (the font size itself) is used where a length should follow the text directly.

export global Th {
    // Set from Rust: kdeglobals font and size, light or dark.
    in-out property <bool> dark: true;
    in-out property <length> font-size: 13.333px;
    in-out property <string> font-family: "";
    in-out property <string> mono: "monospace";
    // The mode in force colours the one accent.
    in-out property <color> accent-target: #4d9cf7;
    out property <color> accent: accent-target;

    out property <color> bg: dark ? #1d1e20 : #f3f3f4;
    out property <color> raised: dark ? #2d2f33 : #e4e5e7;
    out property <color> hover: dark ? #383b40 : #d6d8db;
    out property <color> pressed: dark ? #474b52 : #c0c4c9;
    out property <color> selected: dark ? #393d43 : #cdd0d5;
    out property <color> line: dark ? #383b40 : #cfd1d5;
    out property <color> text: dark ? #eceded : #17181a;
    out property <color> dim: dark ? #a1a6ad : #5a5e65;
    out property <color> focus: dark ? #f4f5f6 : #17181a;
    out property <color> danger: dark ? #ff7070 : #c32f2f;
    out property <color> on-accent: dark ? #0f1113 : #ffffff;

    // 1dp, and the type scale. Body text is 9 pt, headings 10 pt bold, small print 8.5 pt.
    out property <length> dp: font-size / 13.333;
    out property <length> t-body: font-size * 0.9;
    out property <length> t-head: font-size * 0.98;
    out property <length> t-small: font-size * 0.85;
    out property <length> radius: 4 * dp;
    out property <length> control: 26 * dp;
    out property <length> gap: 6 * dp;

    pure public function mode-color(m: string) -> color {
        dark ? (m == "eco-plus" ? #8cd44a : m == "power-saver" ? #35c9a6 : m == "performance" ? #f2673b : #4d9cf7)
             : (m == "eco-plus" ? #4f9a14 : m == "power-saver" ? #0e9d7e : m == "performance" ? #d6481c : #1f74dc)
    }
}

// Monochrome line icons on a 24 x 24 grid.
export global Ic {
    pure public function path(n: string) -> string {
        n == "check" ? "M5 12.5L10 17L19 7.5"
        : n == "left" ? "M15 5L8 12L15 19"
        : n == "right" ? "M9 5L16 12L9 19"
        : n == "chev" ? "M6 9.5L12 15.5L18 9.5"
        : n == "reset" ? "M4 12A8 8 0 1 0 7 5.7M4 3V8H9"
        : n == "warn" ? "M12 3L22 20H2ZM12 10V14M12 17V17.5"
        // modes
        : n == "eco-plus" ? "M4.5 19.5C4.5 10.5 9.5 5 20 4C19.5 14.5 14.5 19.5 4.5 19.5ZM4.5 19.5L13 11"
        : n == "power-saver" ? "M20 14.5A8.2 8.2 0 1 1 9.5 4A6.6 6.6 0 0 0 20 14.5Z"
        : n == "balanced" ? "M12 4V20M7 20H17M5 7.5H19M5 7.5L2.5 14H7.5ZM19 7.5L16.5 14H21.5Z"
        : n == "performance" ? "M13.5 2.5L5 13.5H11.5L10.5 21.5L19 10.5H12.5Z"
        : n == "tune" ? "M4 7H20M4 12H20M4 17H20M9 5V9M15 10V14M8 15V19"
        // gpu
        : n == "eco" ? "M4.5 19.5C4.5 10.5 9.5 5 20 4C19.5 14.5 14.5 19.5 4.5 19.5ZM4.5 19.5L13 11"
        : n == "hybrid" ? "M9 6A6 6 0 1 0 9 18A6 6 0 1 0 9 6ZM15 6A6 6 0 1 0 15 18A6 6 0 1 0 15 6Z"
        : n == "ultimate" ? "M7 8.5H17A5 5 0 0 1 22 13.5V15A3 3 0 0 1 16.2 16L15 14.2H9L7.8 16A3 3 0 0 1 2 15V13.5A5 5 0 0 1 7 8.5ZM7.5 11V15M5.5 13H9.5M16 12.2H16.1M18.4 14.2H18.5"
        : n == "optimized" ? "M12 3L14 10L21 12L14 14L12 21L10 14L3 12L10 10Z"
        // section heads
        : n == "gauge" ? "M3.5 17.5A9.5 9.5 0 1 1 20.5 17.5M12 15L16.5 8.5"
        : n == "chip" ? "M7 7H17V17H7ZM10 3.5V7M14 3.5V7M10 17V20.5M14 17V20.5M3.5 10H7M3.5 14H7M17 10H20.5M17 14H20.5"
        : n == "screen" ? "M3 5H21V16H3ZM8 20H16M12 16V20"
        : n == "laptop" ? "M5 5.5H19V15.5H5ZM2.5 19H21.5"
        : n == "sun" ? "M12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8ZM12 2.5V4.5M12 19.5V21.5M2.5 12H4.5M19.5 12H21.5M5.3 5.3L6.7 6.7M17.3 17.3L18.7 18.7M5.3 18.7L6.7 17.3M17.3 6.7L18.7 5.3"
        : n == "slash" ? "M6 19L9 5M11.5 19L14.5 5M17 19L20 5"
        : n == "keyboard" ? "M2.5 6H21.5V18H2.5ZM6 10H6.1M10 10H10.1M14 10H14.1M18 10H18.1M7 14H17"
        : n == "battery" ? "M2.5 8H19V16H2.5ZM21.5 11V13"
        : n == "system" ? "M12 8.5A3.5 3.5 0 1 0 12 15.5A3.5 3.5 0 1 0 12 8.5ZM12 2.5V5M12 19V21.5M2.5 12H5M19 12H21.5M5.3 5.3L7 7M17 17L18.7 18.7M5.3 18.7L7 17M17 7L18.7 5.3"
        : "M12 5V19M5 12H19"
    }
}

// Focus rings are for the keyboard: a click does not draw one.
export global Nav {
    in-out property <bool> keys;
}
