// Design tokens. Sizes are in `rem` (the system font size), so everything grows with the text.
// 1u = 0.6rem = 8 px at the default 10 pt / 13.33 px text; spacings are multiples of it.

export global Th {
    // Set from Rust: kdeglobals font and size, light or dark.
    in-out property <bool> dark: true;
    in-out property <length> font-size: 13.333px;
    in-out property <string> font-family: "";
    in-out property <string> mono: "monospace";
    // The mode in force colours the one accent.
    in-out property <color> accent-target: #4d9cf7;
    out property <color> accent: accent-target;

    out property <color> bg: dark ? #1b1c1e : #f4f4f5;
    out property <color> raised: dark ? #26282b : #e8e9eb;
    out property <color> hover: dark ? #303338 : #dcdee1;
    out property <color> pressed: dark ? #464a50 : #bfc3c8;
    out property <color> selected: dark ? #393d43 : #cdd0d5;
    out property <color> line: dark ? #34373c : #cdd0d4;
    out property <color> text: dark ? #e9eaec : #16171a;
    out property <color> dim: dark ? #9a9fa6 : #5b5f66;
    out property <color> focus: dark ? #f2f3f5 : #16171a;
    out property <color> danger: dark ? #ff7070 : #c32f2f;
    out property <color> on-accent: dark ? #0f1113 : #ffffff;

    // 8 px rhythm, scaling with the text.
    out property <length> u: font-size * 0.6;
    out property <length> radius: 3px;
    out property <length> control: font-size * 2.4;

    pure public function mode-color(m: string) -> color {
        dark ? (m == "eco-plus" ? #8cd44a : m == "power-saver" ? #35c9a6 : m == "performance" ? #f2673b : #4d9cf7)
             : (m == "eco-plus" ? #4f9a14 : m == "power-saver" ? #0e9d7e : m == "performance" ? #d6481c : #1f74dc)
    }
}

// The few glyphs that carry meaning: stroked paths on a 24 x 24 grid.
export global Ic {
    pure public function path(n: string) -> string {
        n == "check" ? "M5 12.5L10 17L19 7.5"
        : n == "left" ? "M15 5L8 12L15 19"
        : n == "right" ? "M9 5L16 12L9 19"
        : n == "reset" ? "M4 12A8 8 0 1 0 7 5.7M4 3V8H9"
        : n == "warn" ? "M12 3L22 20H2ZM12 10V14M12 17V17.5"
        : "M12 5V19M5 12H19"
    }
}
