// Colours, per-mode accents and the icon set (stroked paths on a 24 x 24 grid).

export global Th {
    in-out property <bool> dark: true;
    in-out property <color> accent-target: #3ddc97;
    out property <color> accent: accent-target;

    // G-Helper's flat language: near-black page, grey buttons, coloured outline for the selection.
    out property <color> bg: dark ? #1c1c1c : #f3f3f3;
    out property <color> surface: dark ? #2d2d2d : #e6e6e6;
    out property <color> surface2: dark ? #383838 : #d9d9d9;
    out property <color> hover: dark ? #3d3d3d : #cfcfcf;
    out property <color> line: dark ? #3a3a3a : #c4c4c4;
    out property <color> text: dark ? #f2f2f2 : #1a1a1a;
    out property <color> dim: dark ? #a0a0a0 : #606060;
    out property <color> blue: #3da5f5;
    out property <color> ring: dark ? #ffffffcc : #000000b0;
    out property <color> danger: dark ? #ff6b6b : #d93636;
    out property <color> on-accent: #0d1014;

    pure public function mode-color(m: string) -> color {
        m == "eco-plus" ? #8bd450
        : m == "power-saver" ? #2fc77a
        : m == "performance" ? #f0503c
        : #3da5f5
    }
}

export global Ic {
    pure public function path(n: string) -> string {
        n == "eco-plus" ? "M5 19C5 10 10 5 19 5C19 14 14 19 5 19ZM5 19L13 11"
        : n == "power-saver" ? "M20 14.5A8.5 8.5 0 1 1 9.5 4A6.5 6.5 0 0 0 20 14.5Z"
        : n == "balanced" ? "M4 8H20M4 16H20M9 5V11M15 13V19"
        : n == "performance" ? "M13 2L4 14H11L10 22L20 9H13Z"
        : n == "gpu" ? "M7 7H17V17H7ZM10 3V7M14 3V7M10 17V21M14 17V21M3 10H7M3 14H7M17 10H21M17 14H21"
        : n == "screen" ? "M3 5H21V16H3ZM8 20H16M12 16V20"
        : n == "battery" ? "M2 8H17V16H2ZM17 11H20V13H17"
        : n == "power" ? "M4 17A9 9 0 1 1 20 17M12 13L16 8"
        : n == "light" ? "M2 6H22V18H2ZM6 10H7M10 10H11M14 10H15M18 10H19M7 14H17"
        : n == "lid" ? "M6 19L10 5M12 19L16 5M18 19L22 5"
        : n == "system" ? "M12 9A3 3 0 1 0 12 15A3 3 0 1 0 12 9M12 2V5M12 19V22M2 12H5M19 12H22M5 5L7 7M17 17L19 19M5 19L7 17M17 7L19 5"
        : n == "close" ? "M6 6L18 18M18 6L6 18"
        : n == "check" ? "M5 12L10 17L19 7"
        : n == "plus" ? "M12 5V19M5 12H19"
        : n == "minus" ? "M5 12H19"
        : n == "left" ? "M15 5L8 12L15 19"
        : n == "right" ? "M9 5L16 12L9 19"
        : n == "ac" ? "M9 3V8M15 3V8M6 8H18V12A6 6 0 0 1 6 12ZM12 18V21"
        : n == "reboot" ? "M20 12A8 8 0 1 1 17.5 6.3M20 3V8H15"
        : n == "warn" ? "M12 3L22 20H2ZM12 10V14M12 17V17.5"
        : n == "eco" ? "M12 3V21M5 9H19"
        : n == "hybrid" ? "M3 12H21M12 3A9 9 0 0 1 12 21"
        : n == "ultimate" ? "M13 2L4 14H11L10 22L20 9H13Z"
        : n == "auto" ? "M4 19L12 4L20 19M7.5 14H16.5"
        : n == "eye" ? "M2 12C5 6 19 6 22 12C19 18 5 18 2 12ZM12 9.5A2.5 2.5 0 1 0 12 14.5A2.5 2.5 0 1 0 12 9.5"
        : n == "sun" ? "M12 8A4 4 0 1 0 12 16A4 4 0 1 0 12 8M12 2V4M12 20V22M2 12H4M20 12H22M5 5L6.5 6.5M17.5 17.5L19 19M5 19L6.5 17.5M17.5 6.5L19 5"
        : n == "palette" ? "M12 3C7 3 3 7 3 12C3 17 7 21 12 21C13.5 21 14 20 13.5 19C13 18 14 17 15 17H17C19.5 17 21 15.5 21 13C21 7.5 17 3 12 3Z"
        : n == "reset" ? "M4 12A8 8 0 1 0 7 5.7M4 3V8H9"
        : n == "full" ? "M12 3V21M3 12H21"
        : n == "fan" ? "M12 12C10 7 12 3 15 3C17 4 16 9 12 12M12 12C17 11 21 13 21 16C20 18 15 17 12 12M12 12C14 17 12 21 9 21C7 20 8 15 12 12"
        : n == "temp" ? "M10 4A2 2 0 0 1 14 4V13A4 4 0 1 1 10 13Z"
        : "M12 5V19M5 12H19"
    }
}
