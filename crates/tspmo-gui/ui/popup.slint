import { Th, Nav } from "theme.slint";
import { Bk, Opt } from "bk.slint";
import { Btn, Seg, Combo, ColorBtn, Check, Chip, Slide, Head, Cap, Mono, Row } from "controls.slint";

// One section: a head and its controls, 6dp apart.
component Section inherits VerticalLayout {
    spacing: 6 * Th.dp;
}

// The main window: one dense column, laid out after G-Helper (mode, GPU, screen, display,
// Slash, keyboard, battery), no scrolling. Everything else opens in its own window.
export component PopupBody inherits VerticalLayout {
    padding-left: 16 * Th.dp;
    padding-right: 16 * Th.dp;
    padding-top: 14 * Th.dp;
    padding-bottom: 14 * Th.dp;
    spacing: 16 * Th.dp;
    min-width: 410 * Th.dp;

    if !Bk.loaded: Rectangle {
        height: 420 * Th.dp;
        VerticalLayout {
            spacing: 14 * Th.dp;
            for h in [84, 84, 56, 70, 50]: Rectangle {
                height: h * Th.dp;
                border-radius: Th.radius;
                background: Th.raised.with-alpha(0.5);
            }
        }
    }

    // Mode
    if Bk.loaded && Bk.mode != "": Section {
        Head { icon: "gauge"; title: Bk.mode-title; info: Bk.mode-info; }
        Seg {
            wheel: true;
            opts: Bk.win-fans ? [
                { id: "eco-plus", label: "Eco+", tint: Th.mode-color("eco-plus"), keyed: true, icon: "eco-plus", dim: false, on: false },
                { id: "power-saver", label: "Silent", tint: Th.mode-color("power-saver"), keyed: true, icon: "power-saver", dim: false, on: false },
                { id: "balanced", label: "Balanced", tint: Th.mode-color("balanced"), keyed: true, icon: "balanced", dim: false, on: false },
                { id: "performance", label: "Turbo", tint: Th.mode-color("performance"), keyed: true, icon: "performance", dim: false, on: false },
                { id: "fans", label: "Fans + Power", tint: Th.dim, keyed: true, icon: "tune", dim: false, on: false },
            ] : [
                { id: "eco-plus", label: "Eco+", tint: Th.mode-color("eco-plus"), keyed: true, icon: "eco-plus", dim: false, on: false },
                { id: "power-saver", label: "Silent", tint: Th.mode-color("power-saver"), keyed: true, icon: "power-saver", dim: false, on: false },
                { id: "balanced", label: "Balanced", tint: Th.mode-color("balanced"), keyed: true, icon: "balanced", dim: false, on: false },
                { id: "performance", label: "Turbo", tint: Th.mode-color("performance"), keyed: true, icon: "performance", dim: false, on: false },
            ];
            index: Bk.mode == "eco-plus" ? 0 : Bk.mode == "power-saver" ? 1 : Bk.mode == "balanced" ? 2 : Bk.mode == "performance" ? 3 : -1;
            picked(i) => {
                if (i == 4) { Bk.open("fans"); } else { Bk.act("mode", ["eco-plus", "power-saver", "balanced", "performance"][i]); }
            }
        }
    }

    // GPU. While Eco+ is on the dGPU is off: Eco shows as chosen, the rest is unavailable.
    if Bk.loaded && Bk.has-gpu: Section {
        Head { icon: "chip"; title: Bk.gpu-title; info: Bk.gpu-info; }
        Seg {
            opts: [
                { id: "eco", label: "Eco", tint: Th.accent, keyed: false, icon: "eco", dim: false, on: false },
                { id: "hybrid", label: "Standard", tint: Th.accent, keyed: false, icon: "hybrid", dim: Bk.gpu-locked, on: false },
                { id: "ultimate", label: "Ultimate", tint: Th.accent, keyed: false, icon: "ultimate", dim: Bk.gpu-locked, on: false },
                { id: "optimized", label: "Optimized", tint: Th.accent, keyed: false, icon: "optimized", dim: Bk.gpu-locked, on: false },
            ];
            index: Bk.gpu-index;
            enabled: Bk.gpu-switching == "";
            picked(i) => {
                if (!Bk.gpu-locked) { Bk.act("gpu", ["eco", "hybrid", "ultimate", "optimized"][i]); }
            }
        }
        if Bk.gpu-reboot: Row {
            h: 24 * Th.dp;
            label: "Reboot for " + Bk.gpu-pending;
            Btn { h: 24 * Th.dp; text: "Reboot"; danger: true; clicked => { Bk.act("reboot", ""); } }
        }
    }

    // Laptop screen: refresh policy and panel overdrive.
    if Bk.loaded && Bk.has-refresh: Section {
        Head { icon: "laptop"; title: Bk.screen-title; }
        Seg {
            wheel: true;
            opts: Bk.refresh-opts;
            index: Bk.refresh-idx;
            picked(i) => {
                if (i == 3) { Bk.act("hw-toggle", "panel_overdrive"); } else { Bk.act("refresh", ["auto", "60", "max"][i]); }
            }
        }
    }

    // Brightness and the visual options.
    if Bk.loaded && (Bk.brightness >= 0 || Bk.has-flicker || Bk.color-labels.length > 0): Section {
        Head {
            icon: "sun";
            title: Bk.has-flicker ? "Flicker-free Dimming / Visual Mode" : "Brightness / Visual Mode";
            info: Bk.brightness >= 0 ? Bk.brightness + "%" : "";
        }
        if Bk.brightness >= 0: Slide {
            min: 1;
            max: 100;
            value: Bk.brightness;
            released(v) => { Bk.acti("brightness", v); }
        }
        HorizontalLayout {
            spacing: 6 * Th.dp;
            if Bk.color-labels.length > 0: Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                items: Bk.color-labels;
                index: Bk.color-idx;
                picked(i) => { Bk.act("color", Bk.color-modes[i].id); }
            }
            if Bk.has-eye: Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                items: Bk.eye-items;
                index: Bk.eye-idx;
                text: Bk.eye-text;
                picked(i) => { Bk.acti("eye", [0, 5500, 4500, 3500][i]); }
            }
            if Bk.has-flicker: Rectangle {
                horizontal-stretch: 1;
                preferred-width: 0px;
                Check {
                    x: 2 * Th.dp;
                    width: parent.width - 2 * Th.dp;
                    label: "Flicker-free";
                    on: Bk.flicker;
                    toggled(v) => { Bk.act("flicker", v ? "on" : "off"); }
                }
            }
        }
    }

    // Slash lighting
    if Bk.loaded && Bk.has-slash: Section {
        Head { icon: "slash"; title: Bk.slash-title; }
        HorizontalLayout {
            spacing: 6 * Th.dp;
            Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                items: ["Off", "Low", "Medium", "High"];
                index: Bk.slash-bright-idx;
                picked(i) => { Bk.acti("slash-bright", i); }
            }
            if Bk.slash-modes.length > 0: Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                items: Bk.slash-modes;
                index: Bk.slash-mode-idx;
                picked(i) => { Bk.acti("slash-mode-set", i); }
            }
            Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                right: true;
                items: ["Interval Off", "Interval 1", "Interval 2", "Interval 3", "Interval 4", "Interval 5"];
                index: Bk.slash-interval;
                text: Bk.slash-interval > 5 ? "Interval " + Bk.slash-interval : "";
                picked(i) => { Bk.acti("slash-interval", i); }
            }
        }
        HorizontalLayout {
            spacing: 6 * Th.dp;
            Check {
                horizontal-stretch: 1;
                preferred-width: 0px;
                label: "Show on battery";
                on: Bk.slash-batt;
                toggled => { Bk.act("hw-toggle", "slash:battery"); }
            }
            Check {
                horizontal-stretch: 1;
                preferred-width: 0px;
                label: "Show on lid close";
                on: Bk.slash-lid;
                toggled => { Bk.act("hw-toggle", "slash:lid"); }
            }
        }
    }

    // Keyboard
    if Bk.loaded && Bk.has-light: Section {
        HorizontalLayout {
            spacing: 6 * Th.dp;
            Head { horizontal-stretch: 1; icon: "keyboard"; title: Bk.kb-title; }
            if Bk.has-fnlock: Chip {
                y: 1 * Th.dp;
                text: "Fn-Lock";
                on: Bk.fnlock;
                toggled(v) => { Bk.act("fnlock", v ? "on" : "off"); }
            }
        }
        HorizontalLayout {
            spacing: 6 * Th.dp;
            Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                up: true;
                items: Bk.kb-levels;
                index: Bk.kb-level;
                picked(i) => { Bk.acti("kb-level", i); }
            }
            if Bk.kb-effects.length > 0: Combo {
                horizontal-stretch: 1;
                preferred-width: 0px;
                up: true;
                items: Bk.kb-effect-labels;
                index: Bk.kb-effect-idx;
                text: Bk.kb-effect-idx < 0 ? "Choose effect" : "";
                picked(i) => { Bk.act("kb-effect", Bk.kb-effects[i].id); }
            }
            if Bk.kb-effects.length > 0: ColorBtn {
                horizontal-stretch: 1;
                preferred-width: 0px;
                label: "Color";
                enabled: Bk.kb-effect-idx >= 0;
                value: Bk.kb-color;
                colors: [#ffffff, #ff3b30, #ff9500, #ffd60a, #34c759, #0a84ff, #bf5af2, #ff2d92];
                index: Bk.kb-color-idx;
                picked(i) => { Bk.acti("kb-color", i); }
            }
        }
    }

    // Battery
    if Bk.loaded && Bk.has-battery: Section {
        Head {
            icon: "battery";
            title: Bk.bat-limit > 0 ? "Battery Charge Limit: " + Bk.bat-limit + "%" : "Battery Charge Limit";
            info: Bk.bat-line;
        }
        if Bk.bat-values.length > 1: Slide {
            min: 0;
            max: Bk.bat-values.length - 1;
            value: Bk.bat-idx;
            released(v) => { Bk.acti("bat-limit", Bk.bat-values[v]); }
        }
    }

    // The rest
    if Bk.loaded && (Bk.win-screen || Bk.win-keys || Bk.win-system): HorizontalLayout {
        spacing: 6 * Th.dp;
        if Bk.win-screen: Btn { horizontal-stretch: 1; preferred-width: 0px; icon: "screen"; text: "Screen"; clicked => { Bk.open("screen"); } }
        if Bk.win-keys: Btn { horizontal-stretch: 1; preferred-width: 0px; icon: "keyboard"; text: "Keyboard & Lid"; clicked => { Bk.open("keys"); } }
        if Bk.win-system: Btn { horizontal-stretch: 1; preferred-width: 0px; icon: "system"; text: "System"; clicked => { Bk.open("system"); } }
    }

    if Bk.error != "": Text {
        text: Bk.error;
        color: Th.danger;
        font-size: Th.t-small;
        wrap: word-wrap;
    }
}

export component Popup inherits Window {
    no-frame: true;
    background: transparent;
    title: "tspmo";
    default-font-size: Th.font-size;
    default-font-family: Th.font-family;

    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Escape) { Bk.close(); return accept; }
            if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) { return reject; }
            if (e.text == "1") { Bk.act("mode", "eco-plus"); return accept; }
            if (e.text == "2") { Bk.act("mode", "power-saver"); return accept; }
            if (e.text == "3") { Bk.act("mode", "balanced"); return accept; }
            if (e.text == "4") { Bk.act("mode", "performance"); return accept; }
            if (e.text == "f" && Bk.win-fans) { Bk.open("fans"); return accept; }
            if (e.text == "s" && Bk.win-screen) { Bk.open("screen"); return accept; }
            if (e.text == "k" && Bk.win-keys) { Bk.open("keys"); return accept; }
            if (e.text == "y" && Bk.win-system) { Bk.open("system"); return accept; }
            return reject;
        }
        Rectangle {
            background: Th.bg;
            border-radius: 8 * Th.dp;
            border-width: 1px;
            border-color: Th.line;
            PopupBody { }
        }
    }
}
