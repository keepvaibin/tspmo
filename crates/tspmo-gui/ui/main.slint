import { Th } from "theme.slint";
import { Bk, Opt, GpuUser, Pt, LimitRow, Item } from "bk.slint";
import { Popup, PopupBody } from "popup.slint";
import { FansWin, ScreenWin, KeysWin, SystemWin } from "windows.slint";
import { Cap, Mono, Icon } from "controls.slint";

export { Bk, Th, Opt, GpuUser, Pt, LimitRow, Item, Popup, FansWin, ScreenWin, KeysWin, SystemWin }

// The on-screen note: icon, text, an optional bar. Click-through, never focused, shown about
// 1.2 s with a short fade at both ends (`shown` is switched by the program).
export component Osd inherits Window {
    no-frame: true;
    background: transparent;
    title: "tspmo osd";
    default-font-size: Th.font-size;
    default-font-family: Th.font-family;
    in property <string> text;
    in property <string> glyph;
    in property <float> value: -1;
    in property <bool> shown: false;
    Rectangle {
        opacity: root.shown ? 1 : 0;
        animate opacity { duration: root.shown ? 90ms : 220ms; easing: ease-out; }
        background: Th.bg;
        border-radius: 6 * Th.dp;
        border-width: 1px;
        border-color: Th.line;
        min-width: 112 * Th.dp;
        VerticalLayout {
            padding-left: 10 * Th.dp;
            padding-right: 12 * Th.dp;
            padding-top: 7 * Th.dp;
            padding-bottom: 7 * Th.dp;
            spacing: 5 * Th.dp;
            HorizontalLayout {
                spacing: 7 * Th.dp;
                alignment: center;
                Icon {
                    name: root.glyph;
                    size: 16 * Th.dp;
                    tint: Th.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.text;
                    color: Th.text;
                    font-size: Th.t-head;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            if root.value >= 0: Rectangle {
                height: 3 * Th.dp;
                border-radius: 1.5 * Th.dp;
                background: Th.raised;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.value, 0, 1);
                    border-radius: parent.border-radius;
                    background: Th.accent;
                }
            }
        }
    }
}
