import { Th, Nav } from "theme.slint";
import { Bk } from "bk.slint";

// Fan curve: 8 draggable points, temperature 20-100 °C across, speed 0-100 % up.
// Arrow keys move the selected point, Ctrl+Left/Right (or , and .) pick another, Shift is the
// fine step, Enter or leaving the editor sends the curve.
export component CurveEditor inherits Rectangle {
    in property <bool> editable: true;
    in property <color> tint: Th.accent;
    property <length> pad-l: 2.4rem;
    property <length> pad-b: 1.5rem;
    property <length> pad-t: 0.6rem;
    property <length> pad-r: 0.6rem;
    property <length> pw: self.width - pad-l - pad-r;
    property <length> ph: self.height - pad-b - pad-t;
    property <int> sel: 0;
    property <int> hot: -1;

    function px(t: int) -> length { root.pad-l + (t - 20) / 80 * root.pw }
    function py(p: int) -> length { root.pad-t + (100 - p) / 100 * root.ph }

    Rectangle {
        x: root.pad-l;
        y: root.pad-t;
        width: root.pw;
        height: root.ph;
        background: Th.bg;
        border-width: 1px;
        border-color: Th.line;
    }
    for v in [0, 25, 50, 75, 100]: Rectangle {
        x: root.pad-l;
        y: root.py(v);
        width: root.pw;
        height: 1px;
        background: Th.line;
        Text {
            x: -root.pad-l;
            y: -0.5rem;
            width: root.pad-l - 0.4rem;
            height: 1rem;
            text: v;
            font-family: Th.mono;
            font-size: 0.75rem;
            color: Th.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    for t in [20, 40, 60, 80, 100]: Rectangle {
        x: root.px(t);
        y: root.pad-t;
        width: 1px;
        height: root.ph;
        background: Th.line;
        Text {
            x: -1.5rem;
            y: root.ph + 0.2rem;
            width: 3rem;
            text: t;
            font-family: Th.mono;
            font-size: 0.75rem;
            color: Th.dim;
            horizontal-alignment: center;
        }
    }
    Text {
        x: root.pad-l + 0.5rem;
        y: root.pad-t + 0.3rem;
        font-family: Th.mono;
        font-size: 0.8rem;
        color: Th.text;
        text: Bk.curve.length > root.sel ? Bk.curve[root.sel].t + " °C  " + Bk.curve[root.sel].p + "%" : "";
    }

    // Slint cannot loop over path elements, so the polyline is spelled out for 8 points.
    pure function seg(i: int) -> string {
        i < Bk.curve.length ? (i == 0 ? "M" : "L") + "\{root.px(Bk.curve[i].t) / 1px} \{root.py(Bk.curve[i].p) / 1px}" : ""
    }
    Path {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        commands: root.seg(0) + root.seg(1) + root.seg(2) + root.seg(3) + root.seg(4) + root.seg(5) + root.seg(6) + root.seg(7);
        stroke: root.tint;
        stroke-width: 2px;
        stroke-line-join: round;
        stroke-line-cap: round;
        fill: transparent;
    }

    fs := FocusScope {
        enabled: root.editable;
        key-pressed(e) => {
            Nav.keys = true;
            if (!root.editable || Bk.curve.length == 0) {
                return reject;
            }
            let step = e.modifiers.shift ? 1 : 5;
            let c = Bk.curve[root.sel];
            if (e.text == Key.UpArrow) {
                Bk.curve-move(root.sel, c.t, c.p + step);
                return accept;
            }
            if (e.text == Key.DownArrow) {
                Bk.curve-move(root.sel, c.t, c.p - step);
                return accept;
            }
            if (e.text == "," || e.text == "<") {
                root.sel = max(0, root.sel - 1);
                return accept;
            }
            if (e.text == "." || e.text == ">") {
                root.sel = min(Bk.curve.length - 1, root.sel + 1);
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) {
                    root.sel = max(0, root.sel - 1);
                } else {
                    Bk.curve-move(root.sel, c.t - step, c.p);
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) {
                    root.sel = min(Bk.curve.length - 1, root.sel + 1);
                } else {
                    Bk.curve-move(root.sel, c.t + step, c.p);
                }
                return accept;
            }
            if (e.text == Key.Return) {
                Bk.curve-commit();
                return accept;
            }
            return reject;
        }
        changed has-focus => {
            if (!self.has-focus) {
                Bk.curve-commit();
            }
        }
    }
    Rectangle {
        border-width: fs.has-focus && Nav.keys ? 2px : 0;
        border-color: Th.focus;
        border-radius: Th.radius;
    }

    for p[i] in Bk.curve: Rectangle {
        x: root.px(p.t) - self.width / 2;
        y: root.py(p.p) - self.height / 2;
        width: 1.8rem;
        height: 1.8rem;
        property <bool> on: ta.has-hover || ta.pressed || (fs.has-focus && Nav.keys && root.sel == i);
        Rectangle {
            width: on ? 0.9rem : 0.6rem;
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 1px;
            background: on ? root.tint : Th.bg;
            border-width: 2px;
            border-color: root.tint;
            animate width { duration: 100ms; }
        }
        ta := TouchArea {
            enabled: root.editable;
            property <length> gx;
            property <length> gy;
            pointer-event(e) => {
                if (e.button == PointerEventButton.left) {
                    if (e.kind == PointerEventKind.down) {
                        fs.focus();
                        Nav.keys = false;
                        root.sel = i;
                        self.gx = self.mouse-x;
                        self.gy = self.mouse-y;
                    } else if (e.kind == PointerEventKind.up) {
                        Bk.curve-commit();
                    }
                }
            }
            moved => {
                if (self.pressed) {
                    let t = p.t + round((self.mouse-x - self.gx) / root.pw * 80);
                    let q = p.p - round((self.mouse-y - self.gy) / root.ph * 100);
                    Bk.curve-move(i, t, q);
                }
            }
        }
    }
}
