import { Th, Ic, Nav } from "theme.slint";
import { Opt } from "bk.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Th.text;
    in property <length> size: 1rem;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: Ic.path(name);
    fill: transparent;
    stroke: tint;
    stroke-width: max(size * 0.085, 1px);
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Dim caption.
export component Cap inherits Text {
    color: Th.dim;
    font-size: Th.t-body;
    vertical-alignment: center;
    overflow: elide;
}

// Live numbers: a monospace face keeps digits from jittering.
export component Mono inherits Text {
    color: Th.dim;
    font-family: Th.mono;
    font-size: Th.t-small;
    vertical-alignment: center;
    horizontal-alignment: right;
}

// Section head: a small icon, a bold title that carries the state, live readings on the right.
export component Head inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> info;
    height: 20 * Th.dp;
    HorizontalLayout {
        spacing: 6 * Th.dp;
        if root.icon != "": Icon {
            name: root.icon;
            size: 15 * Th.dp;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.title;
            color: Th.text;
            font-size: Th.t-head;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.info != "": Mono {
            text: root.info;
            color: Th.text.with-alpha(0.8);
        }
    }
}

// A group head without an icon, for the secondary windows.
export component Field inherits Head { }

export component Rule inherits Rectangle {
    height: 1px;
    background: Th.line;
}

// Ring drawn inside a focused control.
component Ring inherits Rectangle {
    in property <bool> on;
    in property <length> inset: 0;
    Rectangle {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        border-width: root.on ? 1.5px : 0;
        border-color: Th.focus;
        border-radius: max(Th.radius - root.inset, 1px);
    }
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> danger;
    in property <length> h: Th.control;
    callback clicked();
    height: h;
    min-width: 24 * Th.dp;
    border-radius: Th.radius;
    opacity: enabled ? 1 : 0.4;
    background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    Rectangle {
        border-radius: Th.radius;
        border-width: root.active ? 2px : 0;
        border-color: Th.accent;
    }
    HorizontalLayout {
        padding-left: 6 * Th.dp;
        padding-right: 6 * Th.dp;
        spacing: 5 * Th.dp;
        alignment: center;
        if root.icon != "": Icon {
            name: root.icon;
            size: 14 * Th.dp;
            tint: root.danger ? Th.danger : Th.text;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: root.danger ? Th.danger : Th.text;
            font-size: Th.t-body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Ring { on: fs.has-focus && Nav.keys; inset: 3 * Th.dp; }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            Nav.keys = false;
            root.clicked();
        }
    }
}

// Icon-only square button (steppers, reset).
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <length> side: Th.control;
    callback clicked();
    width: side;
    height: side;
    border-radius: Th.radius;
    opacity: enabled ? 1 : 0.4;
    background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    Icon { name: root.icon; size: 13 * Th.dp; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    Ring { on: fs.has-focus && Nav.keys; inset: 3 * Th.dp; }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            Nav.keys = false;
            root.clicked();
        }
    }
}

// A row of equal tiles. The chosen one is outlined in its colour (mode tiles carry their own,
// the others the accent). With icons the tile is a small icon above the label.
// Arrows move the highlight, Enter or Space applies it; the wheel steps when `wheel` is set.
export component Seg inherits Rectangle {
    in property <[Opt]> opts;
    in property <int> index;
    in property <color> tint: Th.accent;
    in property <bool> enabled: true;
    in property <bool> wheel: false;
    // Labels may wrap to two lines (a taller tile, the same for every tile in the row).
    in property <bool> wrap: false;
    in property <length> h: opts.length > 0 && opts[0].icon != "" ? (wrap ? 74 * Th.dp : 58 * Th.dp) : Th.control;
    callback picked(int);
    property <int> cur: index;
    property <length> gap: Th.gap;
    height: h;
    opacity: enabled ? 1 : 0.4;
    fs := FocusScope {
        enabled: root.enabled;
        changed has-focus => {
            if (self.has-focus && Nav.keys) {
                root.cur = max(root.index, 0);
            }
        }
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.LeftArrow) {
                root.cur = max(root.cur - 1, 0);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.cur = min(root.cur + 1, root.opts.length - 1);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                if (!root.opts[root.cur].dim) {
                    root.picked(root.cur);
                }
                return accept;
            }
            return reject;
        }
        for o[i] in root.opts: Rectangle {
            x: i * (self.width + root.gap);
            width: (root.width - root.gap * (root.opts.length - 1)) / max(root.opts.length, 1);
            height: root.height;
            property <bool> sel: i == root.index || o.on;
            property <color> c: o.keyed ? o.tint : root.tint;
            border-radius: Th.radius;
            opacity: o.dim ? 0.38 : 1;
            background: ta.pressed && !o.dim ? Th.pressed : ta.has-hover && !o.dim ? Th.hover : Th.raised;
            animate background { duration: 100ms; }
            animate opacity { duration: 140ms; }
            if o.icon != "": Icon {
                name: o.icon;
                size: 18 * Th.dp;
                tint: sel ? c : Th.text;
                x: (parent.width - self.width) / 2;
                y: 10 * Th.dp;
            }
            Text {
                text: o.label;
                color: Th.text;
                font-size: Th.t-body;
                font-weight: sel ? 700 : 400;
                x: 2 * Th.dp;
                width: parent.width - 4 * Th.dp;
                y: root.wrap ? 33 * Th.dp : o.icon != "" ? parent.height - self.height - 9 * Th.dp : (parent.height - self.height) / 2;
                height: root.wrap ? parent.height - 33 * Th.dp - 7 * Th.dp : self.preferred-height;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: root.wrap ? word-wrap : no-wrap;
                overflow: elide;
            }
            Rectangle {
                border-radius: Th.radius;
                border-width: sel ? 2px : 0;
                border-color: c;
                animate border-color { duration: 140ms; }
            }
            Ring { on: fs.has-focus && Nav.keys && i == root.cur; inset: 3 * Th.dp; }
            ta := TouchArea {
                enabled: !o.dim;
                clicked => {
                    fs.focus();
                    Nav.keys = false;
                    root.cur = i;
                    root.picked(i);
                }
                scroll-event(e) => {
                    if (!root.wheel) {
                        return reject;
                    }
                    if (e.delta-y < 0 && root.index < root.opts.length - 1) {
                        root.picked(root.index + 1);
                    } else if (e.delta-y > 0 && root.index > 0) {
                        root.picked(root.index - 1);
                    }
                    return accept;
                }
            }
        }
    }
}

export component Check inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 18 * Th.dp;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        spacing: 6 * Th.dp;
        Rectangle {
            width: 14 * Th.dp;
            height: 14 * Th.dp;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.on ? Th.accent : (ta.has-hover ? Th.hover : Th.raised);
            border-width: root.on ? 0 : 1px;
            border-color: Th.dim;
            animate background { duration: 100ms; }
            if root.on: Icon { name: "check"; size: 12 * Th.dp; tint: Th.on-accent; x: 1 * Th.dp; y: 1 * Th.dp; }
            Ring { on: fs.has-focus && Nav.keys; inset: -2px; }
        }
        Text { text: root.label; color: Th.text; font-size: Th.t-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Return || e.text == " ") {
                root.toggled(!root.on);
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            Nav.keys = false;
            root.toggled(!root.on);
        }
    }
}

// A small badge that toggles (Fn-Lock).
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback toggled(bool);
    height: 18 * Th.dp;
    width: label.preferred-width + 14 * Th.dp;
    border-radius: 3px;
    background: root.on ? Th.accent : ta.has-hover ? Th.hover : Th.raised;
    label := Text {
        text: root.text;
        color: root.on ? Th.on-accent : Th.text;
        font-size: Th.t-small;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Ring { on: fs.has-focus && Nav.keys; inset: 2 * Th.dp; }
    fs := FocusScope {
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.Return || e.text == " ") {
                root.toggled(!root.on);
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        clicked => {
            fs.focus();
            Nav.keys = false;
            root.toggled(!root.on);
        }
    }
}

// A drop-down: the value and a small arrow; the list opens as a popup inside the window (over
// the rows below, or above them with `up`). Arrows step the value while the list is closed, so
// the keyboard never needs the list. More than eight items flow into several columns.
export component Combo inherits Rectangle {
    in property <[string]> items;
    in property <int> index;
    in property <string> prefix;
    // Shown instead of the item when the value is not in the list.
    in property <string> text;
    in property <bool> up: false;
    in property <bool> right: false;
    in property <bool> enabled: true;
    callback picked(int);
    property <int> rows: min(items.length, 8);
    property <int> cols: ceil(items.length / 8);
    property <length> row-h: 21 * Th.dp;
    height: Th.control - 2 * Th.dp;
    opacity: enabled ? 1 : 0.4;
    border-radius: Th.radius;
    background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    Text {
        x: 7 * Th.dp;
        width: parent.width - 24 * Th.dp;
        text: root.prefix + (root.text != "" ? root.text : (root.index >= 0 && root.index < root.items.length ? root.items[root.index] : ""));
        color: Th.text;
        font-size: Th.t-body;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        name: "chev";
        size: 10 * Th.dp;
        tint: Th.dim;
        x: parent.width - 16 * Th.dp;
        y: (parent.height - self.height) / 2;
    }
    Ring { on: fs.has-focus && Nav.keys; inset: 3 * Th.dp; }
    pop := PopupWindow {
        width: max(root.width, 96 * Th.dp) * root.cols;
        height: root.rows * root.row-h + 4 * Th.dp;
        x: root.right ? root.width - self.width : 0;
        y: root.up ? -self.height - 2 * Th.dp : root.height + 2 * Th.dp;
        Rectangle {
            background: Th.bg;
            border-radius: Th.radius;
            border-width: 1px;
            border-color: Th.dim.with-alpha(0.55);
            for it[i] in root.items: Rectangle {
                x: 2 * Th.dp + floor(i / 8) * ((parent.width - 4 * Th.dp) / root.cols);
                y: 2 * Th.dp + mod(i, 8) * root.row-h;
                width: (parent.width - 4 * Th.dp) / root.cols;
                height: root.row-h;
                border-radius: 3px;
                background: pa.has-hover ? Th.hover : i == root.index ? Th.selected : transparent;
                Text {
                    x: 7 * Th.dp;
                    width: parent.width - 12 * Th.dp;
                    text: it;
                    color: Th.text;
                    font-size: Th.t-body;
                    font-weight: i == root.index ? 700 : 400;
                    vertical-alignment: center;
                    overflow: elide;
                }
                pa := TouchArea {
                    clicked => {
                        pop.close();
                        root.picked(i);
                    }
                }
            }
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.UpArrow || e.text == Key.LeftArrow) {
                if (root.index > 0) {
                    root.picked(root.index - 1);
                }
                return accept;
            }
            if (e.text == Key.DownArrow || e.text == Key.RightArrow) {
                if (root.index < root.items.length - 1) {
                    root.picked(root.index + 1);
                }
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                pop.show();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            Nav.keys = false;
            pop.show();
        }
        scroll-event(e) => {
            if (e.delta-y < 0 && root.index < root.items.length - 1) {
                root.picked(root.index + 1);
            } else if (e.delta-y > 0 && root.index > 0) {
                root.picked(root.index - 1);
            }
            return accept;
        }
    }
}

// The colour square of the keyboard row; the list is a row of swatches.
export component ColorBtn inherits Rectangle {
    in property <string> label;
    in property <color> value;
    in property <[color]> colors;
    in property <int> index;
    in property <bool> right: true;
    in property <bool> up: true;
    in property <bool> enabled: true;
    callback picked(int);
    height: Th.control - 2 * Th.dp;
    border-radius: Th.radius;
    opacity: enabled ? 1 : 0.4;
    background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 7 * Th.dp;
        Text { text: root.label; color: Th.text; font-size: Th.t-body; vertical-alignment: center; }
        Rectangle {
            width: 14 * Th.dp;
            height: 14 * Th.dp;
            y: (parent.height - self.height) / 2;
            background: root.value;
            border-radius: 2px;
            border-width: 1px;
            border-color: Th.dim.with-alpha(0.6);
        }
    }
    Ring { on: fs.has-focus && Nav.keys; inset: 3 * Th.dp; }
    pop := PopupWindow {
        width: root.colors.length * 24 * Th.dp + 8 * Th.dp;
        height: 32 * Th.dp;
        x: root.right ? root.width - self.width : 0;
        y: root.up ? -self.height - 2 * Th.dp : root.height + 2 * Th.dp;
        Rectangle {
            background: Th.bg;
            border-radius: Th.radius;
            border-width: 1px;
            border-color: Th.dim.with-alpha(0.55);
            for c[i] in root.colors: Rectangle {
                x: 4 * Th.dp + i * 24 * Th.dp;
                y: 5 * Th.dp;
                width: 22 * Th.dp;
                height: 22 * Th.dp;
                border-radius: 2px;
                background: c;
                border-width: i == root.index ? 2px : 1px;
                border-color: i == root.index ? Th.focus : Th.line;
                TouchArea {
                    clicked => {
                        pop.close();
                        root.picked(i);
                    }
                }
            }
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.LeftArrow || e.text == Key.UpArrow) {
                root.picked(max(root.index - 1, 0));
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.DownArrow) {
                root.picked(min(root.index + 1, root.colors.length - 1));
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                pop.show();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            Nav.keys = false;
            pop.show();
        }
    }
}

// Horizontal slider: a thin track filled to the value, a round thumb. `moved` while dragging,
// `released` once it settles. Arrows step (Shift: five steps), Home and End jump, the wheel steps.
export component Slide inherits Rectangle {
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> value;
    in property <int> step: 1;
    in property <bool> custom: true;
    in property <bool> enabled: true;
    in property <color> tint: Th.accent;
    callback moved(int);
    callback released(int);
    property <int> drag: value;
    property <int> pending: value;
    property <int> shown: ta.pressed ? drag : (settle.running ? pending : value);
    property <float> frac: max > min ? clamp((shown - min) / (max - min), 0, 1) : 0;
    property <length> thumb: 14 * Th.dp;
    height: 18 * Th.dp;
    opacity: enabled ? 1 : 0.4;
    function at(x: length) -> int {
        root.min + round((clamp((x - thumb / 2) / (root.width - thumb), 0, 1) * (root.max - root.min)) / root.step) * root.step
    }
    function nudge(d: int) {
        root.pending = clamp((settle.running ? root.pending : root.value) + d * root.step, root.min, root.max);
        root.moved(root.pending);
        settle.running = true;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4 * Th.dp;
        border-radius: self.height / 2;
        background: Th.raised;
        Rectangle {
            x: 0;
            width: root.frac * (parent.width - root.thumb) + root.thumb / 2;
            border-radius: parent.border-radius;
            background: root.custom ? root.tint : Th.dim;
            animate width { duration: ta.pressed ? 0ms : 120ms; }
        }
    }
    Rectangle {
        x: root.frac * (root.width - root.thumb);
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: self.width / 2;
        background: root.custom ? root.tint : Th.dim;
        border-width: 2px;
        border-color: ta.pressed ? Th.text : Th.bg;
        animate x { duration: ta.pressed ? 0ms : 120ms; }
        Ring { on: fs.has-focus && Nav.keys; inset: -3px; }
    }
    settle := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.released(root.pending);
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            Nav.keys = true;
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.nudge(e.modifiers.shift ? -5 : -1);
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.nudge(e.modifiers.shift ? 5 : 1);
                return accept;
            }
            if (e.text == Key.Home) {
                root.nudge(-(root.max - root.min));
                return accept;
            }
            if (e.text == Key.End) {
                root.nudge(root.max - root.min);
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    fs.focus();
                    Nav.keys = false;
                    root.drag = root.at(self.mouse-x);
                    root.moved(root.drag);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.drag);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.at(self.mouse-x);
                root.moved(root.drag);
            }
        }
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            root.nudge(e.delta-y > 0 ? 1 : -1);
            return accept;
        }
    }
}

// `Label ─────●──── 40%` on one line.
export component SlideRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> value-int;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in property <bool> custom: true;
    in property <length> label-width: 80 * Th.dp;
    in property <length> value-width: 48 * Th.dp;
    callback moved(int);
    callback released(int);
    height: 22 * Th.dp;
    HorizontalLayout {
        spacing: Th.gap;
        Cap { text: root.label; width: root.label-width; }
        Slide {
            horizontal-stretch: 1;
            min: root.min;
            max: root.max;
            step: root.step;
            value: root.value-int;
            enabled: root.enabled;
            custom: root.custom;
            moved(v) => { root.moved(v); }
            released(v) => { root.released(v); }
        }
        Mono { text: root.value; width: root.value-width; }
    }
}

// `‹ value ›`
export component Stepper inherits Rectangle {
    in property <string> text;
    in property <bool> can-prev: true;
    in property <bool> can-next: true;
    callback prev();
    callback next();
    height: Th.control;
    HorizontalLayout {
        spacing: 2px;
        IconBtn { icon: "left"; enabled: root.can-prev; clicked => { root.prev(); } }
        Rectangle {
            horizontal-stretch: 1;
            background: Th.raised;
            border-radius: Th.radius;
            min-width: 80 * Th.dp;
            Text {
                text: root.text;
                color: Th.text;
                font-size: Th.t-body;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        IconBtn { icon: "right"; enabled: root.can-next; clicked => { root.next(); } }
    }
}

// Label on the left, a control on the right.
export component Row inherits Rectangle {
    in property <string> label;
    in property <length> h: Th.control;
    height: h;
    HorizontalLayout {
        spacing: Th.gap;
        Text { text: root.label; color: Th.text; font-size: Th.t-body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        @children
    }
}
