import { Th, Ic } from "theme.slint";
import { Opt } from "bk.slint";

export component Icon inherits Path {
    in property <string> name;
    in property <color> tint: Th.text;
    in property <length> size: 1rem;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: Ic.path(name);
    fill: transparent;
    stroke: tint;
    stroke-width: 2px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

// Dim caption.
export component Cap inherits Text {
    color: Th.dim;
    font-size: 0.85rem;
    vertical-alignment: center;
    overflow: elide;
}

// Live numbers: a monospace face keeps digits from jittering.
export component Mono inherits Text {
    color: Th.dim;
    font-family: Th.mono;
    font-size: 0.85rem;
    vertical-alignment: center;
    horizontal-alignment: right;
}

// A section line: caption on the left, a live readout on the right.
export component Field inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 1.5rem;
    HorizontalLayout {
        spacing: Th.u;
        Cap { text: root.label; }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: parent.height / 2;
                height: 1px;
                background: Th.line;
            }
        }
        if root.value != "": Mono { text: root.value; }
    }
}

export component Rule inherits Rectangle {
    height: 1px;
    background: Th.line;
}

// Ring drawn inside a focused control.
component Ring inherits Rectangle {
    in property <bool> on;
    border-width: on ? 2px : 0;
    border-color: Th.focus;
    border-radius: Th.radius;
}

export component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> active;
    in property <bool> danger;
    in property <length> h: Th.control;
    callback clicked();
    height: h;
    min-width: 2rem;
    border-radius: Th.radius;
    opacity: enabled ? 1 : 0.4;
    background: ta.pressed ? Th.pressed : (ta.has-hover || active) ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: Th.u;
        padding-right: Th.u;
        spacing: 0.5rem;
        alignment: center;
        Text {
            text: root.text;
            color: root.danger ? Th.danger : Th.text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    Ring { on: fs.has-focus; }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
}

// Icon-only square button (steppers, reset).
export component IconBtn inherits Rectangle {
    in property <string> icon;
    in property <bool> enabled: true;
    in property <length> side: Th.control;
    callback clicked();
    width: side;
    height: side;
    border-radius: Th.radius;
    opacity: enabled ? 1 : 0.4;
    background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
    animate background { duration: 100ms; }
    Icon { name: root.icon; size: 0.9rem; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    Ring { on: fs.has-focus; }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.clicked();
        }
    }
}

// A row of equal tiles. The chosen one carries the accent as a bar and a light tint.
// Arrows move the highlight, Enter or Space applies it; the wheel steps when `wheel` is set.
export component Seg inherits Rectangle {
    in property <[Opt]> opts;
    in property <int> index;
    in property <color> tint: Th.accent;
    in property <bool> enabled: true;
    in property <bool> wheel: false;
    in property <length> h: Th.control;
    callback picked(int);
    property <int> cur: index;
    height: h;
    opacity: enabled ? 1 : 0.4;
    fs := FocusScope {
        enabled: root.enabled;
        changed has-focus => {
            if (self.has-focus) {
                root.cur = max(root.index, 0);
            }
        }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) {
                root.cur = max(root.cur - 1, 0);
                return accept;
            }
            if (e.text == Key.RightArrow) {
                root.cur = min(root.cur + 1, root.opts.length - 1);
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                root.picked(root.cur);
                return accept;
            }
            return reject;
        }
        for o[i] in root.opts: Rectangle {
                x: i * (self.width + 0.3rem);
                width: (root.width - 0.3rem * (root.opts.length - 1)) / max(root.opts.length, 1);
                height: root.height;
                property <bool> sel: i == root.index;
                property <color> c: o.keyed ? o.tint : root.tint;
                border-radius: Th.radius;
                background: ta.pressed ? Th.pressed : ta.has-hover ? Th.hover : Th.raised;
                animate background { duration: 100ms; }
                Rectangle {
                    border-radius: Th.radius;
                    background: sel ? Th.selected : transparent;
                    animate background { duration: 140ms; }
                }
                Rectangle {
                    y: parent.height - self.height;
                    height: sel ? 3px : (o.keyed ? 2px : 0px);
                    background: sel ? c : c.with-alpha(0.5);
                    animate height { duration: 140ms; }
                    animate background { duration: 140ms; }
                }
                Text {
                    text: o.label;
                    color: Th.text;
                    font-weight: sel ? 700 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    border-radius: Th.radius;
                    border-width: fs.has-focus && i == root.cur ? 2px : 0;
                    border-color: Th.focus;
                }
                ta := TouchArea {
                    clicked => {
                        fs.focus();
                        root.cur = i;
                        root.picked(i);
                    }
                    scroll-event(e) => {
                        if (!root.wheel) {
                            return reject;
                        }
                        if (e.delta-y < 0 && root.index < root.opts.length - 1) {
                            root.picked(root.index + 1);
                        } else if (e.delta-y > 0 && root.index > 0) {
                            root.picked(root.index - 1);
                        }
                        return accept;
                    }
                }
            }
    }
}

export component Check inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 1.8rem;
    opacity: enabled ? 1 : 0.4;
    HorizontalLayout {
        spacing: 0.6rem;
        Rectangle {
            width: 1.1rem;
            height: 1.1rem;
            y: (parent.height - self.height) / 2;
            border-radius: 2px;
            background: root.on ? Th.accent : (ta.has-hover ? Th.hover : Th.raised);
            border-width: root.on ? 0 : 1px;
            border-color: Th.dim;
            animate background { duration: 100ms; }
            if root.on: Icon { name: "check"; size: 0.9rem; tint: Th.on-accent; x: 0.1rem; y: 0.1rem; }
            Ring { on: fs.has-focus; x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; }
        }
        Text { text: root.label; color: Th.text; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                root.toggled(!root.on);
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.toggled(!root.on);
        }
    }
}

// Horizontal slider: a flat bar, a vertical thumb. `moved` while dragging, `released` once it
// settles. Arrows step (Shift: five steps), Home and End jump, the wheel steps.
export component Slide inherits Rectangle {
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> value;
    in property <int> step: 1;
    in property <bool> custom: true;
    in property <bool> enabled: true;
    in property <color> tint: Th.accent;
    callback moved(int);
    callback released(int);
    property <int> drag: value;
    property <int> pending: value;
    property <int> shown: ta.pressed ? drag : (settle.running ? pending : value);
    property <float> frac: max > min ? clamp((shown - min) / (max - min), 0, 1) : 0;
    property <length> thumb: 0.45rem;
    height: 2rem;
    opacity: enabled ? 1 : 0.4;
    function at(x: length) -> int {
        root.min + round((clamp((x - thumb / 2) / (root.width - thumb), 0, 1) * (root.max - root.min)) / root.step) * root.step
    }
    function nudge(d: int) {
        root.pending = clamp((settle.running ? root.pending : root.value) + d * root.step, root.min, root.max);
        root.moved(root.pending);
        settle.running = true;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 0.3rem;
        border-radius: 1px;
        background: Th.raised;
        border-width: 1px;
        border-color: Th.line;
        Rectangle {
            x: 0;
            width: root.frac * (parent.width - root.thumb) + root.thumb / 2;
            border-radius: 1px;
            background: root.custom ? root.tint : Th.dim;
            animate width { duration: ta.pressed ? 0ms : 120ms; }
        }
    }
    Rectangle {
        x: root.frac * (root.width - root.thumb);
        y: (parent.height - self.height) / 2;
        width: root.thumb;
        height: 1.3rem;
        border-radius: 2px;
        background: ta.pressed ? root.tint : Th.text;
        animate x { duration: ta.pressed ? 0ms : 120ms; }
        Ring { on: fs.has-focus; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
    }
    settle := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.released(root.pending);
        }
    }
    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.nudge(e.modifiers.shift ? -5 : -1);
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.nudge(e.modifiers.shift ? 5 : 1);
                return accept;
            }
            if (e.text == Key.Home) {
                root.nudge(-(root.max - root.min));
                return accept;
            }
            if (e.text == Key.End) {
                root.nudge(root.max - root.min);
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left) {
                if (e.kind == PointerEventKind.down) {
                    fs.focus();
                    root.drag = root.at(self.mouse-x);
                    root.moved(root.drag);
                } else if (e.kind == PointerEventKind.up) {
                    root.released(root.drag);
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.at(self.mouse-x);
                root.moved(root.drag);
            }
        }
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            root.nudge(e.delta-y > 0 ? 1 : -1);
            return accept;
        }
    }
}

// `Label ─────●──── 40%` on one line.
export component SlideRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> min: 0;
    in property <int> max: 100;
    in property <int> value-int;
    in property <int> step: 1;
    in property <bool> enabled: true;
    in property <bool> custom: true;
    in property <length> label-width: 6rem;
    in property <length> value-width: 3.6rem;
    callback moved(int);
    callback released(int);
    height: 2rem;
    HorizontalLayout {
        spacing: Th.u;
        Cap { text: root.label; width: root.label-width; }
        Slide {
            horizontal-stretch: 1;
            min: root.min;
            max: root.max;
            step: root.step;
            value: root.value-int;
            enabled: root.enabled;
            custom: root.custom;
            moved(v) => { root.moved(v); }
            released(v) => { root.released(v); }
        }
        Mono { text: root.value; width: root.value-width; }
    }
}

// `‹ value ›`
export component Stepper inherits Rectangle {
    in property <string> text;
    in property <bool> can-prev: true;
    in property <bool> can-next: true;
    callback prev();
    callback next();
    height: Th.control;
    HorizontalLayout {
        spacing: 2px;
        IconBtn { icon: "left"; enabled: root.can-prev; clicked => { root.prev(); } }
        Rectangle {
            horizontal-stretch: 1;
            background: Th.raised;
            border-radius: Th.radius;
            min-width: 6rem;
            Text {
                text: root.text;
                color: Th.text;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        IconBtn { icon: "right"; enabled: root.can-next; clicked => { root.next(); } }
    }
}

// Label on the left, a control on the right.
export component Row inherits Rectangle {
    in property <string> label;
    in property <length> h: Th.control;
    height: h;
    HorizontalLayout {
        spacing: Th.u;
        Text { text: root.label; color: Th.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        @children
    }
}
